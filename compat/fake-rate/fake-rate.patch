+void FakeRate::showRevivedEffects(CCNode* layer, CCNode* face, bool show) {
+    // These containers are owned by Grandpa 1.3.0. Never delete or re-parent them:
+    // its effect-key cache expects them to survive until the layer is destroyed.
+    if (layer) {
+        for (auto id : {"ultrasoda.grandpa_demon_revived/grandpa-background",
+                       "ultrasoda.grandpa_demon_revived/grandpa-particles"}) {
+            if (auto node = layer->getChildByID(id)) node->setVisible(show);
+        }
+    }
+    if (face) {
+        if (auto node = face->getChildByID("ultrasoda.grandpa_demon_revived/grandpa-infinity"))
+            node->setVisible(show);
+    }
+}
